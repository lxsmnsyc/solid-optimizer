{
  "name": "solid-optimizer",
  "version": "1.0.0-next.0",
  "description": "Experimental compile-time optimizer for SolidJS",
  "keywords": [
    "compiler",
    "jsx",
    "optimizer",
    "solid-js"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-optimizer/tree/main/packages/solid-optimizer",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-optimizer/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxsmnsyc/solid-optimizer.git",
    "directory": "packages/solid-optimizer"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./vite": "./dist/vite.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "magic-string": "^1.4.2",
    "oxc-parser": "^0.151.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@solidjs/compiler": "2.0.0-rc.11",
    "@solidjs/vite-plugin": "3.0.0-next.46",
    "@solidjs/web": "2.0.0-rc.11",
    "@types/node": "^26.6.3",
    "happy-dom": "^20.14.5",
    "publint": "^0.3.24",
    "solid-js": "2.0.0-rc.11",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@solidjs/vite-plugin": "^3.0.0-next.46",
    "vite": "^8.0.0 || ^9.0.0"
  },
  "peerDependenciesMeta": {
    "@solidjs/vite-plugin": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
